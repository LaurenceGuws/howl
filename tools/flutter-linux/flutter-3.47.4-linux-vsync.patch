+  VsyncCallback vsync_callback = start_engine_with_vsync(
+      engine, &current_time, [&](uint64_t start_time, uint64_t target_time) {
+        frame_start_time = start_time;
+        frame_target_time = target_time;
+      });
+
+  // Produce a 60Hz frame whose target is still in the future.
+  current_time = 10000000;
+  vsync_callback(engine, 42);
+  EXPECT_EQ(frame_start_time, kFrameInterval60);
+  const uint64_t previous_target = frame_target_time;
+
+  // Move to a 240Hz display before that 60Hz frame has completed. The new
+  // cadence starts at the previous target instead of snapping backwards onto
+  // the denser 240Hz clock grid.
+  ON_CALL(mock_gtk, gdk_monitor_get_refresh_rate(::testing::_))
+      .WillByDefault(::testing::Return(240000));
+  fl_engine_send_window_metrics_event(engine, 1, 1, 100, 100, 100, 100, 1.0);
+  current_time = 20000000;
+  vsync_callback(engine, 42);
+  EXPECT_GE(frame_start_time, previous_target);
+  EXPECT_EQ(frame_target_time - frame_start_time, kFrameInterval240);
+}
+
