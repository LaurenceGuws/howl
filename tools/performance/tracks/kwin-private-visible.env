# Isolated visual KWin lab for autonomous Howl work.
# The private compositor is nested visibly on Home but owns its own WMIO/EIS seat.
HORSES_ENVIRONMENT=private-howl-lab
HORSES_HOME_DIR=/home/home
HORSES_MONITOR=WL-0
HORSES_RECT=auto
HORSES_COLS=378
HORSES_ROWS=74
HORSES_FPS=240
HORSES_DURATION_MS=8000
HORSES_GLYPH_SET=alnum
HORSES_SYNCHRONIZED_OUTPUT=1
