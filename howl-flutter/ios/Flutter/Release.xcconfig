#include "Generated.xcconfig"

// Pressure-branch-only app-private native-host proof. The static library is
// generated by the GitHub macOS furnace and never exists on accepted main.
OTHER_LDFLAGS = $(inherited) -force_load $(PROJECT_DIR)/NativePressure/libhowl_ios_native.a -lc++ \
  -Wl,-u,_howl_ios_native_canary_version -Wl,-u,_howl_ios_native_render_hcr1 \
  -Wl,-u,_howl_native_host_version -Wl,-u,_howl_native_host_create -Wl,-u,_howl_native_host_observe \
  -Wl,-u,_howl_native_control_create -Wl,-u,_howl_native_control_mouse \
  -Wl,-exported_symbol,_howl_ios_native_canary_version -Wl,-exported_symbol,_howl_ios_native_render_hcr1 \
  -Wl,-exported_symbol,_howl_native_host_version -Wl,-exported_symbol,_howl_native_host_create \
  -Wl,-exported_symbol,_howl_native_host_observe -Wl,-exported_symbol,_howl_native_control_create \
  -Wl,-exported_symbol,_howl_native_control_mouse
